{
  // Type-checks the renderer's ES modules and the domain modules they use.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["*.js", "domain/*.js", "types/*.d.ts", "preload.cts"]
}
