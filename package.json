{
  "name": "clementina-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/apps/desktop/main.js",
  "scripts": {
    "build": "tsc && node scripts/build-page.mjs",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -p apps/desktop",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:desktop": "npm run build && electron tests/desktop-smoke.cjs",
    "test:desktop:shell": "npm run build && electron tests/desktop-shell.cjs",
    "test:desktop:animation": "npm run build && electron tests/desktop-animation.cjs",
    "test:desktop:background": "npm run build && electron tests/desktop-background.cjs",
    "test:desktop:overlay": "npm run build && electron tests/desktop-overlay.cjs",
    "test:desktop:navigation": "npm run build && electron tests/desktop-navigation.cjs",
    "test:desktop:editing": "npm run build && electron tests/desktop-editing.cjs",
    "test:desktop:conventions": "npm run build && electron tests/desktop-conventions.cjs",
    "test:desktop:audio": "npm run build && electron tests/desktop-audio.cjs",
    "test:ui": "npm run build && electron tests/desktop-workflow.cjs && electron tests/desktop-shell.cjs && electron tests/desktop-animation.cjs && electron tests/desktop-background.cjs && electron tests/desktop-overlay.cjs && electron tests/desktop-navigation.cjs && electron tests/desktop-editing.cjs && electron tests/desktop-conventions.cjs && electron tests/desktop-audio.cjs && electron tests/desktop-smoke.cjs && electron tests/desktop-builder.cjs",
    "test:all": "npm test && npm run test:ui",
    "test:firmware": "npm run build && node tests/firmware/audio-crosscheck.mjs",
    "test:desktop:builder": "npm run build && electron tests/desktop-builder.cjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^22.0.0",
    "electron": "^44.3.0",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.70.1"
  },
  "dependencies": {
    "@clementina/assets": "file:../clementina-sdk/packages/assets",
    "@clementina/build": "file:../clementina-sdk/packages/build",
    "@clementina/core": "file:../clementina-sdk/packages/core",
    "@clementina/emulator-client": "file:../clementina-sdk/packages/emulator-client",
    "@clementina/project": "file:../clementina-sdk/packages/project"
  }
}
